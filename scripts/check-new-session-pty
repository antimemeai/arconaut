#!/usr/bin/env python3
"""Fresh-session switches and restart routing; isolated files, no provider calls."""
import errno
import fcntl
import importlib.util
import json
import os
from pathlib import Path
import importlib.util as packet_import
packet_spec = packet_import.spec_from_file_location('native_packet', Path(__file__).resolve().parent.parent / 'scripts/native-packet.py')
native_packet = packet_import.module_from_spec(packet_spec)
packet_spec.loader.exec_module(native_packet)
import pty
import select
import signal
import struct
import subprocess
import sys
import tempfile
import termios
import time

spec = importlib.util.spec_from_file_location("screen", Path(__file__).with_name("terminal-screen-oracle.py"))
oracle = importlib.util.module_from_spec(spec)
spec.loader.exec_module(oracle)
executable = str(Path(sys.argv[1]).resolve())

with tempfile.TemporaryDirectory(prefix="blackbird-new-") as work:
    root = Path(work)
    original = root / "original"
    workflow = root / "local.lua"
    workflow.write_text("print('LOCAL_WORKFLOW_ONLY')\n")
    master, slave = pty.openpty()
    before = termios.tcgetattr(slave)
    fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", 32, 120, 0, 0))
    screen = oracle.Screen()
    child = subprocess.Popen([executable, "--session", str(original), "--workflow", str(workflow),
                              "--model", "local-test-model", "--effort", "high"],
                             stdin=slave, stdout=slave, stderr=slave, start_new_session=True,
                             env=dict(os.environ, BLACKBIRD_GRAPHICS="off"))

    def wait(predicate, label, seconds=8):
        deadline = time.monotonic() + seconds
        while time.monotonic() < deadline:
            if select.select([master], [], [], 0.03)[0]:
                try:
                    screen.feed(os.read(master, 65536))
                except OSError as error:
                    if error.errno != errno.EIO:
                        raise
            if predicate():
                return
        raise AssertionError(f"{label}\n{screen.text()}")

    def command(text):
        os.write(master, (text + "\r").encode())

    def saved(directory):
        return native_packet.read_packet((directory / "session-info.bbm"))

    def context(directory):
        return subprocess.check_output([executable, "--session", str(directory), "--once", "/context"], text=True)

    def tasks(directory):
        return subprocess.check_output([executable, "--session", str(directory), "--once", '/tasks read {}'], text=True)

    try:
        wait(lambda: "Workflow reloads" in screen.text(), "initial UI")
        command("/name Origin workspace")
        wait(lambda: saved(original).get("name") == "Origin workspace", "retained name")
        initial = saved(original)
        command("/tasks add OLD_TASK")
        wait(lambda: "t1 OLD_TASK" in screen.text(), "original task")
        command("/lua blackbird.append({{role='user',content='OLD_CONTEXT'}}); print('OLD_SAVED')")
        wait(lambda: "OLD_SAVED" in screen.text(), "original context")
        # Switching waits behind active work and preserves later queued prompts
        # as drafts in the old session instead of running them in the new one.
        command("/lua blackbird.call('exec',{argv={'/bin/sh','-c','echo BUSY_START; sleep 0.6; echo BUSY_DONE'}})")
        wait(lambda: "BUSY_START" in screen.text(), "busy operation")
        command("/new")
        command("/lua print('SHOULD_REMAIN_QUEUED')")
        wait(lambda: len(list(root.glob('session-*/session-info.bbm'))) == 1 and
             "Workflow reloads" in screen.text() and "OLD_TASK" not in screen.text(), "fresh UI")
        fresh = next(root.glob('session-*'))
        info = saved(fresh)
        assert info['conversation'] != initial['conversation']
        for key in ('model', 'effort', 'workflow'):
            assert info[key] == initial[key], (key, info)
        assert fresh.stat().st_mode & 0o777 == 0o700
        assert 'OLD_CONTEXT' in context(original)
        assert 'OLD_TASK' in tasks(original)
        old_ui = native_packet.read_packet((original / 'ui-state.bbm'))
        assert any('SHOULD_REMAIN_QUEUED' in bytes.fromhex(value).decode()
                   for value in old_ui['queued'])
        command("/tasks add NEW_TASK")
        wait(lambda: "t1 NEW_TASK" in screen.text(), "new task ID starts fresh")
        # Repeated restarts must stay in this session, including after re-exec.
        for _ in range(2):
            command("/clear")
            wait(lambda: "LOCAL_WORKFLOW_ONLY" not in screen.text(), "clear before restart")
            command("/restart local switch check")
            wait(lambda: "LOCAL_WORKFLOW_ONLY" in screen.text(), "restart local continuation")
            command("/session")
            wait(lambda: info['conversation'] in ''.join(line[:82].replace('│', '').replace(' ', '') for line in screen.text().splitlines()), "restart routed to fresh session")
        # A picker selection loads a command; explicit Enter opens the destination.
        command("/sessions")
        wait(lambda: "Sessions /" in screen.text(), "saved-session picker")
        os.write(master, b"Origin workspace\r")
        wait(lambda: "> /resume " in screen.text(), "picker loads return command")
        os.write(master, b"\r")
        wait(lambda: "t1 OLD_TASK" in screen.text() and "NEW_TASK" not in screen.text(), "original task projection restored")
        assert saved(original)['conversation'] == initial['conversation']
        # Drafts belong to each session, and are restored without submitting.
        command("/resume " + str(fresh))
        wait(lambda: "t1 NEW_TASK" in screen.text(), "fresh task projection restored")
        os.write(master, b"UNSENT_FRESH_DRAFT")
        wait(lambda: bytes.fromhex(native_packet.read_packet((fresh / 'ui-state.bbm'))['draft']).decode() == 'UNSENT_FRESH_DRAFT', "fresh draft saved")
        os.write(master, b"\x14")
        os.write(master, b"sessions\r\r")
        wait(lambda: "Sessions /" in screen.text(), "picker over unsent draft")
        os.write(master, b"Origin workspace\r\r")
        wait(lambda: "t1 OLD_TASK" in screen.text(), "draft switch original")
        command("/resume " + str(fresh))
        wait(lambda: "t1 NEW_TASK" in screen.text(), "draft switch back")
        command("/draft 1")
        wait(lambda: "> UNSENT_FRESH_DRAFT" in screen.text(), "preserved recovered draft")
        os.write(master, b"\x15")
        # Busy and corrupt destinations fail once and return to this session.
        with (original / 'audit').open('rb') as held:
            fcntl.flock(held, fcntl.LOCK_EX | fcntl.LOCK_NB)
            command("/clear")
            wait(lambda: "Workflow reloads" not in screen.text(), "clear before busy destination")
            command("/resume " + str(original))
            wait(lambda: "t1 NEW_TASK" in screen.text() and "Workflow reloads" in screen.text(), "busy destination returns")
            assert child.poll() is None
        corrupt = root / 'broken'
        corrupt.mkdir()
        (corrupt / 'audit').write_bytes(b'broken')
        command("/clear")
        wait(lambda: "Workflow reloads" not in screen.text(), "clear before failed destination")
        command("/resume " + str(corrupt))
        wait(lambda: "t1 NEW_TASK" in screen.text() and "Workflow reloads" in screen.text(), "failed destination returns")
        command("/new")
        wait(lambda: len(list(root.glob('session-*/session-info.bbm'))) == 2 and
             "Workflow reloads" in screen.text() and "NEW_TASK" not in screen.text(), "second fresh UI")
        command("/quit")
        wait(lambda: child.poll() is not None, "normal exit")
        assert child.returncode == 0
        try:
            after = termios.tcgetattr(slave)
        except termios.error as error:
            # Darwin revokes the controlling PTY after the shell launcher exits.
            # Native runs retain the terminal and check restored settings below.
            if not (sys.platform == 'darwin' and error.args[0] == errno.ENOTTY
                    and Path(executable).name == 'blackbird'
                    and Path(executable).parent.name == 'scripts'):
                raise
        else:
            pending = getattr(termios, 'PENDIN', 0)
            before[3] &= ~pending
            after[3] &= ~pending
            assert after == before, ("terminal mode not restored", before, after)
        assert 'OLD_CONTEXT' not in context(fresh)
        assert 'OLD_TASK' not in tasks(fresh)
        assert 'NEW_TASK' in tasks(fresh)
        second = next(path for path in root.glob('session-*') if path != fresh)
        assert 'OLD_CONTEXT' not in context(second)
        assert 'NEW_TASK' not in tasks(second)
        print("Fresh-session PTY: settings, identity/context/task isolation, busy queue preservation, repeated switches/restarts and normal exit pass")
    finally:
        if child.poll() is None:
            try:
                os.killpg(child.pid, signal.SIGKILL)
            except (PermissionError, ProcessLookupError):
                child.kill()
            child.wait(timeout=5)
        os.close(master)
        os.close(slave)
