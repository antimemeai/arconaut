#!/bin/sh
# Development turn driver. The native candidate runner owns the finite process budget.
set -eu
if [ "$#" -lt 3 ]; then
  echo 'usage: autodev-segments RUN ABSOLUTE_DEADLINE COMMAND [ARGS...]' >&2
  exit 2
fi
run=$1
deadline=$2
shift 2
case "$run" in /*) ;; *) echo 'absolute run directory required' >&2; exit 2 ;; esac
case "$deadline" in ''|*[!0-9]*) echo 'integer deadline required' >&2; exit 2 ;; esac
segment=0
while :; do
  [ ! -f "$run/unit-complete.json" ] || exit 0
  if [ -f "$run/pause" ]; then
    echo 'autodev: stopped with unfinished unit; pause retained' >&2
    exit 3
  fi
  if [ "$(date +%s)" -ge "$deadline" ]; then
    echo 'autodev: deadline reached with unfinished unit' >&2
    exit 124
  fi
  segment=$((segment + 1))
  if [ "$segment" -eq 1 ]; then prompt="$run/mission.txt"; else prompt="$run/continue.txt"; fi
  if "$@" --prompt "$prompt"; then
    : # A successful turn is a boundary, not unit completion.
  else
    status=$?
    echo "autodev: segment failed ($status); preserve outcome, no blind replay" >&2
    exit "$status"
  fi
done
