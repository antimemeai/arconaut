#!/bin/sh
set -eu
arco_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
arco_executable=${ARCO_EXECUTABLE:-"$arco_root/build/release/arco"}
arco_probe=false
arco_session="$HOME/.local/state/arconaut/default"
arco_plain=false
arco_once=false
arco_value=''
for arco_argument in "$@"; do
  if [ -n "$arco_value" ]; then
    if [ "$arco_value" = session ]; then arco_session=$arco_argument; fi
    arco_value=''
    continue
  fi
  case "$arco_argument" in
    --help|--list-sessions|--audit-last) arco_probe=true ;;
    --session) arco_value=session ;;
    --model|--effort|--workflow) arco_value=skip ;;
    --once) arco_once=true; arco_value=skip ;;
    --resume-once) arco_once=true ;;
    --plain) arco_plain=true ;;
  esac
done
# Keep interactive startup on its published generation while the dev campaign
# builds/replaces arco. Explicit executable selection always wins.
if [ -z "${ARCO_EXECUTABLE:-}" ] && ! "$arco_once" && ! "$arco_probe" &&
   [ -x "$arco_root/build/release/arco-ui" ]; then
  arco_executable="$arco_root/build/release/arco-ui"
fi
if ! "$arco_once" && ! "$arco_probe" && [ -t 0 ] && [ -t 1 ]; then
  printf 'Opening Arconaut session: %s\n' "$arco_session" >&2
fi
while :; do
  if "$arco_executable" "$@"; then exit 0; else arco_status=$?; fi
  if [ "$arco_status" -ne 75 ]; then exit "$arco_status"; fi
  set -- --session "$arco_session" --resume-continue
  if "$arco_plain"; then set -- "$@" --plain; fi
  if "$arco_once"; then set -- "$@" --resume-once; fi
done
