diff --git a/tests/operational_metadata_test.cpp b/tests/operational_metadata_test.cpp
new file mode 100644
index 0000000..43ed0d9
--- /dev/null
+++ b/tests/operational_metadata_test.cpp
@@ -0,0 +1,240 @@
+#include "blackbird/coding.hpp"
+#include "blackbird/json.hpp"
+#include <filesystem>
+#include <iostream>
+#include <unistd.h>
+using namespace blackbird;
+namespace {
+void check(bool good, const char *message) {
+  if (!good)
+    throw std::runtime_error(message);
+}
+template <class T> T id(unsigned char n) {
+  IdentityBytes bytes{};
+  bytes[0] = std::byte{n};
+  return unwrap(T::from_bytes(bytes));
+}
+class Provider final : public CodingProvider {
+public:
+  Value reply = unwrap(parse_json(
+      R"({"model":"observed-model","usage":{"input_tokens":17,"output_tokens":3,"input_tokens_details":{"cached_tokens":5}},"output":[]})"));
+  unsigned calls = 0, failures = 0;
+  std::string_view provider_identity() const noexcept override {
+    return "test-provider";
+  }
+  Value respond(const Value &, const std::function<void(std::string_view)> &) override {
+    ++calls;
+    if (failures) {
+      --failures;
+      throw Error{ErrorCode::provider_transport, 92};
+    }
+    return reply;
+  }
+};
+Value metadata(AuditLog &log, std::string_view label) {
+  for (std::size_t i = log.root().fact_count(); i != 0; --i) {
+    const auto fact = unwrap(log.root().fact(i - 1));
+    const auto *record = std::get_if<ApplicationRecordEvent>(&fact.event.body);
+    if (!record || record->channel != ApplicationChannel::log)
+      continue;
+    const auto packet = unwrap(read_packet(record->payload));
+    if (packet.find("label") && string_field(packet, "label") == label)
+      return field(packet, "metadata");
+  }
+  throw std::runtime_error("metadata record missing");
+}
+} // namespace
+int main() {
+  char name[] = "/tmp/blackbird-operational-XXXXXX";
+  const auto *directory = mkdtemp(name);
+  if (!directory)
+    return 2;
+  try {
+    const JournalHeader header{id<EnvironmentId>(1),
+                               id<AuditStreamId>(2),
+                               3,
+                               {1024 * 1024, 4 * 1024 * 1024},
+                               std::nullopt};
+    auto root =
+        unwrap(RetainedState::create(std::make_unique<NativeJournalDirectory>(unwrap(
+                                         NativeJournalDirectory::open(directory))),
+                                     "audit", header, {32 * 1024 * 1024, 20000}));
+    Value pinned, query, participant_pinned, participant_query;
+    {
+      AuditLog log{*root};
+      ContextStore context{log};
+      Provider provider;
+      CodingEngine engine{log, context, provider, "requested-model"};
+      engine.turn({"", "return blackbird.request()"});
+      const auto observed = metadata(log, "operation.result");
+      check(string_field(observed, "requested_model") == "requested-model" &&
+                string_field(observed, "actual_model") == "observed-model" &&
+                string_field(observed, "provider") == "test-provider",
+            "requested and observed model/provider are absent or conflated");
+      check(field(observed, "reported_usage") == field(provider.reply, "usage") &&
+                string_field(observed, "usage_status") == "reported",
+            "reported usage differs from actual response");
+      check(string_field(observed, "model_metadata_status") == "observed" &&
+                observed.find("duration_ns") && observed.find("time"),
+            "observed timing/model availability missing");
+      provider.reply = unwrap(parse_json(R"({"output":[]})"));
+      engine.turn({"", "return blackbird.request()"});
+      const auto absent = metadata(log, "operation.result");
+      check(field(absent, "actual_model") == Value{} &&
+                field(absent, "reported_usage") == Value{} &&
+                string_field(absent, "usage_status") == "unavailable" &&
+                string_field(absent, "model_metadata_status") == "unavailable",
+            "missing usage/model invented rather than explicit unavailable");
+      provider.reply =
+          unwrap(parse_json(R"({"model":7,"usage":{"input_tokens":-1},"output":[]})"));
+      engine.turn({"", "return blackbird.request()"});
+      const auto malformed = metadata(log, "operation.result");
+      check(string_field(malformed, "model_metadata_status") == "malformed" &&
+                string_field(malformed, "usage_status") == "malformed" &&
+                field(malformed, "reported_usage") == Value{},
+            "malformed observations accepted as measured usage/model");
+      provider.failures = 1;
+      provider.reply = unwrap(parse_json(
+          R"({"model":"retry-model","usage":{"output_tokens":2},"output":[]})"));
+      engine.turn(
+          {"",
+           "return "
+           "blackbird.request({retry_policy={max_attempts=2,base_ms=0,cap_ms=0}})"});
+      unsigned requests = 0;
+      Value group;
+      for (const auto &fact : root->committed_facts()) {
+        const auto *record = std::get_if<ApplicationRecordEvent>(&fact.event.body);
+        if (!record || record->channel != ApplicationChannel::log)
+          continue;
+        const auto packet = unwrap(read_packet(record->payload));
+        if (!packet.find("label") ||
+            string_field(packet, "label") != "provider.request")
+          continue;
+        const auto &meta = field(packet, "metadata");
+        if (field(meta, "ordinal") == Value{Number{2}}) {
+          ++requests;
+          check(field(meta, "retry_group") == group,
+                "retry group lost across attempts");
+        } else
+          group = field(meta, "retry_group");
+      }
+      check(requests == 1 && provider.calls == 5, "retry or dispatch count differs");
+      provider.reply = Value::object(
+          {{"model", Value{std::string(257, 'm')}},
+           {"usage", Value::object({{"huge", Value::object({{std::string(2050, 'x'),
+                                                             Value{Number{1}}}})}})},
+           {"output", Value{Value::Array{}}}});
+      engine.turn({"", "return blackbird.request()"});
+      const auto bounded = metadata(log, "operation.result");
+      check(string_field(bounded, "model_metadata_status") == "bounded" &&
+                string_field(bounded, "usage_status") == "bounded" &&
+                field(bounded, "actual_model") == Value{} &&
+                field(bounded, "reported_usage") == Value{},
+            "over-limit response metadata lacks bounded availability");
+      engine.turn({"", "return blackbird.call('lua',{code=\"return "
+                       "blackbird.call('read_file',{path='/dev/null'})\"})"});
+      Value parent, child;
+      for (const auto &fact : root->committed_facts()) {
+        const auto *record = std::get_if<ApplicationRecordEvent>(&fact.event.body);
+        if (!record || record->channel != ApplicationChannel::log)
+          continue;
+        const auto packet = unwrap(read_packet(record->payload));
+        if (!packet.find("label") ||
+            string_field(packet, "label") != "operation.result")
+          continue;
+        const auto &meta = field(packet, "metadata");
+        if (field(meta, "operation") == Value{"lua"})
+          parent = field(meta, "attempt");
+        if (field(meta, "operation") == Value{"read_file"})
+          child = meta;
+      }
+      check(parent != Value{} && field(child, "parent_attempt") == parent &&
+                field(child, "attempt") != parent,
+            "nested child parent was inferred incorrectly or lost");
+      const auto participant_begin = root->fact_count();
+      auto participant_request = unwrap(parse_json(
+          R"({"request_id":"delivery","from":"main","to":"worker","provider":"openai","model":"fake","task":"metadata check","context":[],"profile":{"name":"context-only","provenance":"test","timeout_seconds":3,"tools":"none","requests":1}})"));
+      for (auto &[field_name, value] : participant_request.object())
+        if (field_name == "model" || field_name == "request_id")
+          value = Value{std::string(9000, field_name == "model" ? 'm' : 'r')};
+      unsigned participant_calls = 0;
+      engine.participant_transport = [&](const Value &prepared,
+                                         const ColleagueCapture &capture,
+                                         const std::function<bool()> &) {
+        ++participant_calls;
+        check(field(field(prepared, "request"), "request_id").string().size() == 9000,
+              "instrumentation changed exact delivery identity");
+        capture("raw", "received worker response");
+        return unwrap(parse_json(
+            R"({"status":"completed","model":"worker-model","usage":{"output_tokens":4},"output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"done"}]}]})"));
+      };
+      const auto participant = engine.operator_call(
+          "participant_start", Value::object({{"request", participant_request}}));
+      const auto run_id = field(participant, "run_id");
+      const auto joined = engine.operator_call(
+          "participant_join",
+          Value::object({{"run_ids", Value{Value::Array{run_id}}}}));
+      check(participant_calls == 1 &&
+                string_field(field(joined, "runs").array()[0], "state") == "completed",
+            "bounded observation metadata changed actual completion");
+      participant_query = Value::object({{"cursor", Value{Number{participant_begin}}},
+                                         {"end", Value{Number{root->fact_count()}}},
+                                         {"attempt", run_id},
+                                         {"count", Value{Number{64}}},
+                                         {"scan", Value{Number{256}}}});
+      participant_pinned = log.trajectory(participant_query);
+      bool participant_visible = false;
+      for (const auto &row : field(participant_pinned, "events").array())
+        if (row.find("label") &&
+            field(row, "label") == Value{"participant.observation"}) {
+          const auto &meta = field(row, "metadata");
+          check(field(meta, "request_id") == Value{} &&
+                    field(meta, "requested_model") == Value{} &&
+                    field(meta, "request_id_status") == Value{"bounded"} &&
+                    field(meta, "requested_model_status") == Value{"bounded"} &&
+                    field(meta, "reported_usage") ==
+                        Value::object({{"output_tokens", Value{Number{4}}}}) &&
+                    field(field(row, "time"), "clock_id") ==
+                        field(field(observed, "time"), "clock_id") &&
+                    row.find("started_time") && row.find("duration_ns"),
+                "bounded participant availability/clock/usage lost in metadata query");
+          participant_visible = true;
+        }
+      check(participant_visible,
+            "actual participant observation missing from run-filtered query");
+      query = Value::object({{"cursor", Value{Number{0}}},
+                             {"count", Value{Number{64}}},
+                             {"scan", Value{Number{256}}},
+                             {"end", Value{Number{root->fact_count()}}}});
+      const auto page = log.trajectory(query);
+      bool visible = false;
+      for (const auto &row : field(page, "events").array())
+        if (const auto *meta = row.find("metadata"))
+          visible |= meta->find("actual_model") != nullptr;
+      check(visible, "metadata requires reading original provider payload");
+      pinned = page;
+      engine.turn({"", "return 7"});
+      check(log.trajectory(query) == pinned,
+            "later work changed pinned operational metadata");
+      unwrap(context.checkpoint());
+    }
+    root.reset();
+    root = unwrap(RetainedState::open(std::make_unique<NativeJournalDirectory>(unwrap(
+                                          NativeJournalDirectory::open(directory))),
+                                      "audit", header, {32 * 1024 * 1024, 20000}));
+    unwrap(root->confirm_recovery());
+    AuditLog reopened{*root};
+    check(root->compact_recovery() && reopened.trajectory(query) == pinned &&
+              reopened.trajectory(participant_query) == participant_pinned,
+          "operational metadata changed or lost in compact reopen");
+    std::filesystem::remove_all(directory);
+  } catch (const std::exception &error) {
+    std::cerr << error.what() << '\n';
+    std::filesystem::remove_all(directory);
+    return 1;
+  } catch (const Error &error) {
+    std::cerr << error_name(error.code) << '\n';
+    std::filesystem::remove_all(directory);
+    return 1;
+  }
+}
