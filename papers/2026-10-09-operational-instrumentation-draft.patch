diff --git a/src/operation_metadata.cpp b/src/operation_metadata.cpp
new file mode 100644
index 0000000..0b6cc7d
--- /dev/null
+++ b/src/operation_metadata.cpp
@@ -0,0 +1,116 @@
+#include "blackbird/operation_metadata.hpp"
+#include "blackbird/packet.hpp"
+#include <algorithm>
+#include <set>
+namespace blackbird {
+namespace {
+bool model_text(const Value &value) {
+  const auto *text = std::get_if<std::string>(&value.value());
+  return text && !text->empty() && text->size() <= 256 &&
+         text->find('\0') == std::string::npos && valid_utf8(*text);
+}
+bool numeric_usage(const Value &value) {
+  if (const auto *number = std::get_if<Number>(&value.value())) {
+    return std::visit(
+        [](const auto &n) {
+          using T = std::decay_t<decltype(n)>;
+          if constexpr (std::is_same_v<T, Decimal>)
+            return !n.negative || n.limbs.empty();
+          else
+            return n >= 0;
+        },
+        number->storage());
+  }
+  const auto *object = std::get_if<Value::Object>(&value.value());
+  if (!object)
+    return false;
+  std::set<std::string_view> names;
+  return std::all_of(object->begin(), object->end(), [&](const auto &entry) {
+    return !entry.first.empty() && entry.first.size() <= 64 &&
+           entry.first.find('\0') == std::string::npos &&
+           names.insert(entry.first).second && numeric_usage(entry.second);
+  });
+}
+} // namespace
+void append_operation_metadata(Value &destination, const Value &fields) {
+  for (const auto &[key, value] : fields.object()) {
+    bool replaced = false;
+    for (auto &[name, existing] : destination.object())
+      if (name == key) {
+        existing = value;
+        replaced = true;
+        break;
+      }
+    if (!replaced)
+      destination.object().emplace_back(key, value);
+  }
+}
+Value reported_operation_metadata(const Value &response, std::string_view model_key) {
+  Value actual;
+  std::string status = "unavailable";
+  if (const auto *model = response.find(model_key); model && *model != Value{}) {
+    if (model_text(*model)) {
+      actual = *model;
+      status = "observed";
+    } else {
+      const auto *text = std::get_if<std::string>(&model->value());
+      status = text && text->size() > 256 && valid_utf8(*text) &&
+                       text->find('\0') == std::string::npos
+                   ? "bounded"
+                   : "malformed";
+    }
+  }
+  if (const auto *reported = response.find("model_metadata_status");
+      reported && std::holds_alternative<std::string>(reported->value()) &&
+      (reported->string() == "ambiguous" || reported->string() == "malformed")) {
+    actual = Value{};
+    status = reported->string();
+  }
+  Value models;
+  if (const auto *map = response.find("model_usage");
+      map && std::holds_alternative<Value::Object>(map->value())) {
+    Value::Array names;
+    if (map->object().size() <= 16) {
+      for (const auto &[name, unused] : map->object()) {
+        (void)unused;
+        if (!model_text(Value{name})) {
+          names.clear();
+          status = "malformed";
+          actual = Value{};
+          break;
+        }
+        names.emplace_back(name);
+      }
+      models = Value{std::move(names)};
+      if (!encode_packet(models, {4096, 128, 4}).has_value()) {
+        models = Value{};
+        actual = Value{};
+        status = "bounded";
+      }
+    } else {
+      actual = Value{};
+      status = "bounded";
+    }
+  }
+  Value usage;
+  std::string usage_status = "unavailable";
+  if (const auto *reported = response.find("usage"); reported && *reported != Value{}) {
+    if (!std::holds_alternative<Value::Object>(reported->value()))
+      usage_status = "malformed";
+    else if (const auto encoded = encode_packet(*reported, {2048, 128, 4});
+             !encoded.has_value())
+      usage_status = "bounded";
+    else if (!numeric_usage(*reported))
+      usage_status = "malformed";
+    else {
+      usage = *reported;
+      usage_status = "reported";
+    }
+  }
+  return Value::object({{"actual_model", actual},
+                        {"model_metadata_status", Value{status}},
+                        {"reported_models", models},
+                        {"reported_usage", usage},
+                        {"usage_status", Value{usage_status}}});
+}
+} // namespace blackbird
