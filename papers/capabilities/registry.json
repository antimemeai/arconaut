{
  "scope": "104 external reference directories plus historical Arconaut; exact pinned corpus, not current internet-wide feature claims",
  "capabilities": [
    {
      "id": "filesystem",
      "meaning": "Read/search/edit/patch files exposed to a model or programmable client."
    },
    {
      "id": "processes",
      "meaning": "Execute OS programs; distinguish shell-only from PTY/streaming/ongoing handles and lifetime control."
    },
    {
      "id": "code_actions",
      "meaning": "Model-authored executable programs or code actions compose tools, not merely JSON calls to fixed tools."
    },
    {
      "id": "persistent_kernel",
      "meaning": "Interpreter/kernel state persists across actions; record owning process, lifetime, restart and serialization limits."
    },
    {
      "id": "standing_database",
      "meaning": "Model/program-accessible standing structured/queryable state; distinguish evidence DB/service from internal hidden storage or remembered text."
    },
    {
      "id": "workflow_programming",
      "meaning": "Executable/declarative workflows or strategy programs are exposed for composition/replacement; distinguish editable prompts."
    },
    {
      "id": "multi_model",
      "meaning": "Multiple providers/models, routing or switching; do not infer simultaneous collaboration from provider choice."
    },
    {
      "id": "live_collaboration",
      "meaning": "Addressed messages between independently working participants; inspect busy-target delivery, visibility and ownership."
    },
    {
      "id": "concurrent_work",
      "meaning": "Multiple active operations/children/participants or long-running work with meaningful handles/results."
    },
    {
      "id": "steering_interrupt",
      "meaning": "Input/steering during work and actual cancellation/interruption semantics, not UI acknowledgement alone."
    },
    {
      "id": "turn_redefinition",
      "meaning": "Turn/continuation/context scheduling program can change; inspect activation boundary and old work."
    },
    {
      "id": "compaction",
      "meaning": "Managed context transformation strategies, triggers, actual retained/discarded material and tool protocol pairing."
    },
    {
      "id": "context_repair",
      "meaning": "Retrieve originals/lineage to repair omitted or corrupted active context; transcript resume alone is not enough."
    },
    {
      "id": "original_audit",
      "meaning": "Retention of original captured provider/program/transformation IO and failures; distinguish transcript, summaries, clipped output and artifact provenance."
    },
    {
      "id": "audit_query",
      "meaning": "Agent/program-usable query/search/retrieval of the retained audit corpus with explicit scope."
    },
    {
      "id": "hot_change",
      "meaning": "Definition/config/plugin changes during operation; distinguish next call/turn/restart, active frames, and executable replacement."
    },
    {
      "id": "rebuild_continuity",
      "meaning": "Actual harness executable rebuild/replacement and re-inhabitation with context/identity/work retained; transcript resume is partial."
    },
    {
      "id": "remote_services",
      "meaning": "Direct remote execution/service APIs and reconnect/session semantics; describe consumer versus governor boundary."
    },
    {
      "id": "self_improvement",
      "meaning": "Dedicated executable policy/harness/experiment change-and-evaluate machinery; generic file editing alone does not establish autoresearch governance."
    },
    {
      "id": "complaints",
      "meaning": "Model-invokable complaints/bug reporting with captured state and follow-up; distinguish operator-only /bug or bare issue creation."
    },
    {
      "id": "authority",
      "meaning": "Standing execution/tool authority and model agency, approval defaults/overrides, program modification rights."
    },
    {
      "id": "evaluation",
      "meaning": "Evaluation/test/oracle mechanisms and real fault classes observed in source; test quantity is not correctness evidence."
    },
    {
      "id": "time_order",
      "meaning": "Wall/monotonic time, deadlines, causal/order identity or restart/paused-time semantics where exposed."
    }
  ],
  "statuses": {
    "implemented": "I: traced exposed implementation; not runtime-validated",
    "documented": "D: documented contract/claim; implementation unavailable or not traced",
    "limited": "L: relevant capability has a material documented/traced limitation; specify basis",
    "mechanism": "S: supporting primitive requiring composition, not a turnkey agent feature",
    "unknown": "?: not established in explicitly inspected paths; not a universal absence claim",
    "na": "\u2014: outside this reference role; explain why"
  },
